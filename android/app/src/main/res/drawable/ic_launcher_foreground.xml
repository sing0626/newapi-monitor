<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon 前景：脈衝（ECG 實時監察線）— 構圖已收喺 66dp 安全圓內，圓形／方圓裁切都唔會掃角 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 底層微光：青色同形放大，營造脈衝發光感 -->
    <path
        android:pathData="M30,54 H45 L52.5,39 L61.5,69 L69,54 H76"
        android:strokeColor="#22D3EE"
        android:strokeAlpha="0.16"
        android:strokeWidth="17"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 脈衝主線：紫→青漸變 -->
    <path
        android:pathData="M30,54 H45 L52.5,39 L61.5,69 L69,54 H76"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="54"
                android:endX="76"
                android:endY="54">
                <item
                    android:offset="0"
                    android:color="#FF8B5CF6" />
                <item
                    android:offset="1"
                    android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 終點圓點：實時數據「到站」 -->
    <path
        android:fillColor="#FF22D3EE"
        android:pathData="M76,54 m-4.8,0 a4.8,4.8 0 1,1 9.6,0 a4.8,4.8 0 1,1 -9.6,0" />
</vector>
